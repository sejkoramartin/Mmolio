# The phone packet parser and the store with its ordering rules are Bridge's own files,
# compiled in unchanged so both receivers accept exactly the same readings.
project.manifest = manifest.xml

base.sourcePath = source;../shared;../MmolioBridge/source/GlucoseReading.mc;../MmolioBridge/source/GlucoseStore.mc
base.resourcePath = resources

# Both Fenix variants share the 280px MIP resources.
fenix7xpro.resourcePath = $(base.resourcePath);resources-fenix
fenix7xpronowifi.resourcePath = $(base.resourcePath);resources-fenix
