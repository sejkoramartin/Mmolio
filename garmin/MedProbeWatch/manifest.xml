<?xml version="1.0"?>
<!--
  MedProbe watch app for Garmin Connect IQ.

  A watch face cannot receive phone messages, so this is a watch-app: it registers for
  Connect IQ messages, stores the newest reading, and displays it.

  A separate watch face reading this through a complication is the next step and needs its
  own project — Connect IQ will not let one application be both a watch-app and a face.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="a1b2c3d4e5f647589a0b1c2d3e4f5061"
        type="watch-app"
        name="@Strings.AppName"
        entry="MedProbe.MedProbeApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0">

        <iq:products>
            <!--
              Only devices with installed SDK definitions can be listed. fr255 and the
              music/small variants belong here too; add them once their definitions are
              fetched in the SDK manager, together with the matching jungle line.
            -->
            <iq:product id="fr165"/>
        </iq:products>

        <iq:permissions>
            <!-- Receiving messages from the phone. -->
            <iq:uses-permission id="Communications"/>
            <!--
              No Background permission: without a ServiceDelegate the compiler warns that
              the whole application would be loaded as a background process, which is not
              what we want. Staying registered while closed needs a service, and that
              belongs with the watch face work rather than here.
            -->
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
