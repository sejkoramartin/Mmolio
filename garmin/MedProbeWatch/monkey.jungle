# Build configuration.
#
# Device-specific resources override the shared ones rather than duplicating logic:
# fr255 and fr165 differ in screen size and shape, not in behaviour.

project.manifest = manifest.xml

base.sourcePath = source
base.resourcePath = resources

fr255.resourcePath = $(base.resourcePath);resources-fr255
fr255m.resourcePath = $(base.resourcePath);resources-fr255
fr255s.resourcePath = $(base.resourcePath);resources-fr255
fr255sm.resourcePath = $(base.resourcePath);resources-fr255

fr165.resourcePath = $(base.resourcePath);resources-fr165
fr165m.resourcePath = $(base.resourcePath);resources-fr165
